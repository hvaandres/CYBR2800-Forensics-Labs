# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/

# ---------------------------------------------------------------
# Generated forensic evidence
#
# The generator scripts write these into the current working
# directory. They are large, binary, and non-reproducible (each
# build gets a new filesystem UUID and new timestamps, so each
# build has a different SHA-256). Keep the master out of git and
# distribute it through the LMS instead.
# ---------------------------------------------------------------
*.dd
*.dd.sha256
*.dd.gz
*_manifest.txt

# Generator scratch directories
lab*_build/

# ---------------------------------------------------------------
# Instructor-only material
#
# ANSWER_KEY.md contains deleted filenames, inode numbers, and the
# full indicator list. It must never reach a student-visible
# branch or a repo students can clone.
# ---------------------------------------------------------------
ANSWER_KEY.md
**/ANSWER_KEY.md
*.answers.md

# ---------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# ---------------------------------------------------------------
# Auditbeat lab runtime state
#
# data/ holds Auditbeat's own registry (beat.db, meta.json, the
# lock file). It is per-machine runtime state and regenerates on
# every start. evidence/ is where students drop sample artifacts
# during the lab, so its contents are per-student, but the empty
# directory itself must exist for the bind mount to work.
# ---------------------------------------------------------------
docker/auditbeat/data/
docker/auditbeat/evidence/*
!docker/auditbeat/evidence/.gitkeep

# Elasticsearch's own index data (from docker-compose.elastic.yml). Regenerates
# on every stack start; must not be committed.
docker/auditbeat/esdata/*
!docker/auditbeat/esdata/.gitkeep
